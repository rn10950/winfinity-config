[Textcompletion: no match]
commandline[$e]=
logfile[$e]=
presentation=1
soundfile[$e]=

[Textcompletion: partial match]
commandline[$e]=
logfile[$e]=
presentation=1
soundfile[$e]=

[Textcompletion: rotation]
commandline[$e]=
logfile[$e]=
presentation=1
soundfile[$e]=

[Trash: emptied]
commandline[$e]=
logfile[$e]=
presentation=1
soundfile[$e]=/opt/trinity/share/sounds/recycle.mp3

[cancellogout]
commandline[$e]=
logfile[$e]=
presentation=16
soundfile[$e]=

[cannotopenfile]
commandline[$e]=
logfile[$e]=
presentation=0
soundfile[$e]=

[catastrophe]
commandline[$e]=
logfile[$e]=
presentation=2
soundfile[$e]=

[exittde]
commandline[$e]=
logfile[$e]=
presentation=1
soundfile[$e]=/opt/trinity/share/sounds/logoff.mp3

[fatalerror]
commandline[$e]=
logfile[$e]=
presentation=2
soundfile[$e]=

[messageCritical]
commandline[$e]=
logfile[$e]=
presentation=65
soundfile[$e]=/opt/trinity/share/sounds/chord.mp3

[messageInformation]
commandline[$e]=
logfile[$e]=
presentation=65
soundfile[$e]=/opt/trinity/share/sounds/ding.mp3

[messageWarning]
commandline[$e]=
logfile[$e]=
presentation=65
soundfile[$e]=/opt/trinity/share/sounds/chord.mp3

[messageboxQuestion]
commandline[$e]=
logfile[$e]=
presentation=64
soundfile[$e]=KDE_Vox_Ahem.ogg

[notification]
commandline[$e]=
logfile[$e]=
presentation=1
soundfile[$e]=/opt/trinity/share/sounds/notify.mp3

[printerror]
commandline[$e]=
logfile[$e]=
presentation=2
soundfile[$e]=

[starttde]
commandline[$e]=
logfile[$e]=
presentation=1
soundfile[$e]=/opt/trinity/share/sounds/The Microsoft Sound.mp3

[warning]
